# The secretary (DESIGN.md §4.1): the lab's state and its web UI, on the tailnet.
# Runs as the secretary's own Unix user (lab-secretary). Address from
# /etc/agentic-lab/secretary.env:   LAB_BIND=<this host's tailnet IP>   LAB_PORT=8774

[Unit]
Description=Agentic Lab secretary
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=lab-secretary
Group=lab-secretary
WorkingDirectory=~
EnvironmentFile=/etc/agentic-lab/secretary.env
ExecStart=/opt/agentic-lab/venv/bin/lab --lab /etc/agentic-lab/lab.yaml secretary serve --host ${LAB_BIND} --port ${LAB_PORT}
Restart=always
RestartSec=5
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

#!/bin/bash
# git's credential helper for an agent: the token of the GitHub identity that lab.yaml maps
# to this repository (else the agent's default identity). The agent's service writes
# $root/repos.tsv ("<owner/repo pattern>\t<identity>"), $root/default, and a token per
# identity ($root/<identity>/token, kept fresh for GitHub Apps).
[ "$1" = get ] || exit 0
shopt -s nocasematch        # GitHub owner and repository names are case-insensitive
root=${LAB_GITHUB_DIR:-$HOME/.local/share/agentic-lab/github}
host="" path=""
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    case $key in host) host=$value ;; path) path=$value ;; esac
done
[ "$host" = github.com ] || exit 0
repo=${path%.git}
repo=${repo%/}
name=$(head -n 1 "$root/default" 2>/dev/null)
if [ -f "$root/repos.tsv" ]; then
    while IFS=$'\t' read -r pattern identity; do
        # shellcheck disable=SC2053  # the pattern is a glob on purpose (owner/*)
        if [[ $repo == $pattern ]]; then name=$identity; break; fi
    done < "$root/repos.tsv"
fi
[ -n "$name" ] && [ -f "$root/$name/token" ] || exit 0
echo "username=x-access-token"
echo "password=$(head -n 1 "$root/$name/token")"
